---
import type { CollectionEntry } from 'astro:content';
import { incoming, outgoing, stepName, stepOf } from '../lib/minimal-set';

interface Props {
  step: string;
  docs: CollectionEntry<'docs'>[];
  currentId: string;
}

const { step, docs, currentId } = Astro.props;
const ref = stepOf(step)?.ref;

// 各つながりを「リンクの並び」に落とす。説明は title 属性にだけ残す。
const links = (hs: { from: string; to: string; what: string }[], side: 'from' | 'to') =>
  hs.flatMap((h) => {
    const key = h[side];
    const ds = docs
      .filter((d) => d.data.step === key && d.id !== currentId)
      .sort((a, b) => a.id.length - b.id.length);
    if (ds.length === 0) return [{ label: stepName(key), what: h.what }];
    if (ds.length === 1) return [{ href: `/docs/${ds[0].id}`, label: stepName(key), what: h.what }];
    return ds.map((d) => ({ href: `/docs/${d.id}`, label: d.data.title, what: h.what }));
  });

const prev = links(incoming(step), 'from');
const next = links(outgoing(step), 'to');
---
{(prev.length > 0 || next.length > 0 || ref) && (
  <footer class="handoffs">
    {prev.length > 0 && (
      <span><b>前から</b>{prev.map((l) => l.href ? <a href={l.href} title={l.what}>{l.label}</a> : <span class="empty" title={l.what}>{l.label}</span>)}</span>
    )}
    {next.length > 0 && (
      <span><b>次へ</b>{next.map((l) => l.href ? <a href={l.href} title={l.what}>{l.label}</a> : <span class="empty" title={l.what}>{l.label}</span>)}</span>
    )}
    {ref && <span class="handoffs-ref">参考: {ref}</span>}
  </footer>
)}
