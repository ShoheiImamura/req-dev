---
import type { CollectionEntry } from 'astro:content';
import { incoming, outgoing, stepName, stepOf } from '../lib/minimal-set';

interface Props {
  step: string;
  docs: CollectionEntry<'docs'>[];
  currentId: string;
}

const { step, docs, currentId } = Astro.props;
const inH = incoming(step);
const outH = outgoing(step);
const ref = stepOf(step)?.ref;

const targets = (key: string) =>
  docs.filter((d) => d.data.step === key && d.id !== currentId)
    .sort((a, b) => a.id.length - b.id.length);

const label = (key: string, ds: CollectionEntry<'docs'>[]) => {
  if (ds.length === 1 && ds[0].data.title !== stepName(key)) return ds[0].data.title;
  return stepName(key);
};
---
{(inH.length > 0 || outH.length > 0) && (
  <nav class="handoffs" aria-label="前後のつながり">
    {inH.length > 0 && (
      <div>
        <h2>前から</h2>
        <ul>
          {inH.map((h) => {
            const ds = targets(h.from);
            return (
              <li>
                {ds.length === 0
                  ? <span class="empty">{stepName(h.from)}（未作成）</span>
                  : ds.length === 1
                    ? <a href={`/docs/${ds[0].id}`}>{label(h.from, ds)}</a>
                    : ds.map((d) => <a href={`/docs/${d.id}`}>{d.data.title}</a>)}
                <small>{h.what}</small>
              </li>
            );
          })}
        </ul>
      </div>
    )}
    {outH.length > 0 && (
      <div>
        <h2>次へ</h2>
        <ul>
          {outH.map((h) => {
            const ds = targets(h.to);
            return (
              <li>
                {ds.length === 0
                  ? <span class="empty">{stepName(h.to)}（未作成）</span>
                  : ds.length === 1
                    ? <a href={`/docs/${ds[0].id}`}>{label(h.to, ds)}</a>
                    : ds.map((d) => <a href={`/docs/${d.id}`}>{d.data.title}</a>)}
                <small>{h.what}</small>
              </li>
            );
          })}
        </ul>
      </div>
    )}
    {ref && <p class="handoffs-ref">参考: {ref}</p>}
  </nav>
)}
