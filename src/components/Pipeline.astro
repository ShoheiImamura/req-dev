---
import type { CollectionEntry } from 'astro:content';
import { STEPS, SPINE, stepName, sortDocs } from '../lib/minimal-set';
import type { StepKey } from '../lib/minimal-set';

interface Props { docs: CollectionEntry<'docs'>[] }
const { docs } = Astro.props;

const docsFor = (step: string) =>
  sortDocs(docs.filter((d) => d.data.step === step));

const chip = (step: StepKey) => {
  const ds = docsFor(step);
  const status = ds.length === 0 ? 'todo' : ds[0].data.status;
  const href = ds[0] ? `/docs/${ds[0].id}` : undefined;
  const meta = STEPS.find((s) => s.key === step)!;
  return { name: stepName(step), status, href, hint: meta.hint, hub: step === 'information' };
};
---
<section class="pipeline">
  <p class="pipeline-lead">
    お客様の価値から、ユースケースと処理までを一本で辿る。
    名詞は「情報」が正本で、そこから画面・処理・データへ分かれる。
  </p>

  <div class="pipe-main">
    {SPINE.main.map((key, i) => {
      const c = chip(key);
      return (
        <>
          {i > 0 && <span class="pipe-arrow" aria-hidden="true">→</span>}
          <div class={`pipe-stage ${c.hub ? 'is-hub' : ''}`}>
            <h3>
              <span class={`dot ${c.status}`}></span>
              {c.href ? <a href={c.href}>{c.name}</a> : <span class="empty">{c.name}</span>}
            </h3>
            <p class="pipe-hint">{c.hint}</p>
          </div>
        </>
      );
    })}
  </div>

  <div class="pipe-branch-row">
    <p class="pipe-branch-label">
      <span class="pipe-from">ユースケースが扱う名詞</span>
      <span class="pipe-arrow" aria-hidden="true">↓</span>
    </p>
    <div class="pipe-main">
      {SPINE.hub.map((key, i) => {
        const c = chip(key);
        return (
          <>
            {i > 0 && <span class="pipe-arrow" aria-hidden="true">⇄</span>}
            <div class={`pipe-stage ${c.hub ? 'is-hub' : ''}`}>
              <h3>
                <span class={`dot ${c.status}`}></span>
                {c.href ? <a href={c.href}>{c.name}</a> : <span class="empty">{c.name}</span>}
              </h3>
              <p class="pipe-hint">{c.hint}</p>
            </div>
          </>
        );
      })}
    </div>
    <p class="pipe-branch-label">
      <span class="pipe-from">情報から</span>
      <span class="pipe-arrow" aria-hidden="true">↘</span>
    </p>
    <div class="pipe-branches">
      {SPINE.out.map((key) => {
        const c = chip(key);
        return (
          <div class="pipe-stage">
            <h3>
              <span class={`dot ${c.status}`}></span>
              {c.href ? <a href={c.href}>{c.name}</a> : <span class="empty">{c.name}</span>}
            </h3>
            <p class="pipe-hint">{c.hint}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
