---
// 本線と分岐を一枚で見せる。層ごとの表ではなく、受け渡しの形で進捗を読む。
import type { CollectionEntry } from 'astro:content';
import { LAYERS, LAYER_SECTIONS, artifactName } from '../lib/minimal-set';
import type { LayerKey } from '../lib/minimal-set';

interface Props { docs: CollectionEntry<'docs'>[] }
const { docs } = Astro.props;

const docsFor = (layer: string, artifact: string) =>
  docs.filter((d) => d.data.layer === layer && d.data.artifact === artifact);

const chip = (layer: LayerKey, key: string) => {
  const ds = docsFor(layer, key);
  const status = ds.length === 0 ? 'todo' : ds[0].data.status;
  const href = ds[0] ? `/docs/${ds[0].id}` : undefined;
  return { name: artifactName(layer, key), status, href };
};
---
<section class="pipeline">
  <p class="pipeline-lead">
    匠で「なぜ」、RDRA で「何がつながるか」、ICONIX で「どう動くか」。
    名詞（情報モデル）だけ TM（DB）と OOUI（画面）へ分岐する。
  </p>

  <div class="pipe-main">
    {LAYER_SECTIONS[0].layers.map((layerKey, i) => {
      const layer = LAYERS.find((l) => l.key === layerKey)!;
      return (
        <>
          {i > 0 && <span class="pipe-arrow" aria-hidden="true">→</span>}
          <div class={`pipe-stage pipe-${layer.key}`}>
            <h3>{layer.name}</h3>
            <ul>
              {layer.artifacts.map((a) => {
                const c = chip(layer.key, a.key);
                return (
                  <li class={a.key === 'information-model' ? 'hub' : undefined}>
                    <span class={`dot ${c.status}`}></span>
                    {c.href ? <a href={c.href}>{c.name}</a> : <span class="empty">{c.name}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        </>
      );
    })}
  </div>

  <div class="pipe-branch-row">
    <p class="pipe-branch-label">
      <span class="pipe-from">RDRA 情報モデル・UC複合図</span>
      <span class="pipe-arrow" aria-hidden="true">↘</span>
    </p>
    <div class="pipe-branches">
      {LAYER_SECTIONS[1].layers.map((layerKey) => {
        const layer = LAYERS.find((l) => l.key === layerKey)!;
        return (
          <div class={`pipe-stage pipe-${layer.key}`}>
            <h3>{layer.name}{layer.key === 'tm' ? '（DB）' : '（画面）'}</h3>
            <ul>
              {layer.artifacts.map((a) => {
                const c = chip(layer.key, a.key);
                return (
                  <li>
                    <span class={`dot ${c.status}`}></span>
                    {c.href ? <a href={c.href}>{c.name}</a> : <span class="empty">{c.name}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
