---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { stepIndex, stepName } from '../lib/minimal-set';

const docs = await getCollection('docs');
const withQ = docs
  .filter((d) => d.data.questions.length > 0)
  .sort((a, b) => stepIndex(a.data.step) - stepIndex(b.data.step));
const openTotal = withQ.reduce((n, d) => n + d.data.questions.filter((q) => q.status === 'open').length, 0);
const fmt = (d?: Date) => d ? d.toISOString().slice(0, 10) : '';
---
<Base title="確認事項一覧">
  <h1>確認事項一覧 <span class="count">未解決 {openTotal}</span></h1>
  <p>認識を合わせたい点を、流れの順にまとめたものです。決まったことは「回答・決定」に残します。</p>

  {withQ.length === 0 && <p class="empty">確認事項はまだありません。</p>}

  {withQ.map((d) => {
    const open = d.data.questions.filter((q) => q.status === 'open');
    const resolved = d.data.questions.filter((q) => q.status === 'resolved');
    return (
      <section>
        <h2><small class="count">{stepName(d.data.step)}</small><br /><a href={`/docs/${d.id}`}>{d.data.title}</a> <StatusBadge status={d.data.status} /></h2>
        <table>
          <thead><tr><th style="width:8%">状態</th><th>確認したいこと</th><th style="width:35%">回答・決定</th><th style="width:10%">起票</th></tr></thead>
          <tbody>
            {[...open, ...resolved].map((q) => (
              <tr class={q.status}>
                <td><span class={`badge ${q.status}`}>{q.status === 'open' ? '未解決' : '解決'}</span></td>
                <td>{q.q}</td><td>{q.note ?? ''}</td><td>{fmt(q.asked)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    );
  })}
</Base>
