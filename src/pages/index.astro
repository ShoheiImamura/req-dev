---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Pipeline from '../components/Pipeline.astro';
import { STEPS } from '../lib/minimal-set';

const docs = await getCollection('docs');
const docsFor = (step: string) =>
  docs.filter((d) => d.data.step === step).sort((a, b) => a.id.length - b.id.length);
const total = STEPS.length;
const done = STEPS.filter((s) => docsFor(s.key).some((d) => d.data.status === 'agreed')).length;
const fmt = (d?: Date) => d ? d.toISOString().slice(0, 10) : '';
---
<Base title="一連の流れ">
  <h1>要件定義 <span class="count">合意済み {done} / {total}</span></h1>
  <p>手法の図を並べない。価値からユースケース／処理まで、同じ名詞でつなぐ。</p>
  <Pipeline docs={docs} />

  <table>
    <thead>
      <tr>
        <th style="width:18%">流れ</th>
        <th>ドキュメント</th>
        <th style="width:14%">状態</th>
        <th style="width:10%">未解決</th>
        <th style="width:12%">更新</th>
      </tr>
    </thead>
    <tbody>
      {STEPS.map((step) => {
        const ds = docsFor(step.key);
        if (ds.length === 0) {
          return (
            <tr>
              <td>{step.name}<br /><small class="count">{step.hint}</small></td>
              <td class="empty">src/content/docs/{step.key}.md を作成</td>
              <td><StatusBadge status="todo" /></td>
              <td>-</td>
              <td></td>
            </tr>
          );
        }
        return ds.map((d, i) => (
          <tr>
            {i === 0 && (
              <td rowspan={ds.length}>
                {step.name}<br /><small class="count">{step.hint}</small>
              </td>
            )}
            <td>
              <a href={`/docs/${d.id}`}>{d.data.title}</a>
              {d.data.summary && <><br /><small class="count">{d.data.summary}</small></>}
            </td>
            <td><StatusBadge status={d.data.status} /></td>
            <td>{d.data.questions.filter((q) => q.status === 'open').length}</td>
            <td>{fmt(d.data.updated)}</td>
          </tr>
        ));
      })}
    </tbody>
  </table>
  <p class="later">後回し: 業務の細分割、バリエーション（規模が出てから）。クラス図は処理とデータで足りる間は書かない。</p>
</Base>
