---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const docs = (await getCollection('docs')).filter((d) => note.data.related.includes(d.id));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={note.data.title}>
  <header class="doc-head">
    <div class="crumbs"><a href="/notes">受領情報・調査メモ</a> / {note.data.kind === 'customer' ? 'お客様から受領' : 'こちらで調査'}</div>
    <h1>{note.data.title}</h1>
    <div class="meta">
      <span>{fmt(note.data.date)}</span>
      {note.data.url && <a href={note.data.url} target="_blank" rel="noopener">{note.data.url}</a>}
      {note.data.tags.length > 0 && <span>{note.data.tags.join(', ')}</span>}
    </div>
    {note.data.summary && <p>{note.data.summary}</p>}
  </header>
  <Content />
  {docs.length > 0 && (
    <section class="related">
      <h2>反映先のドキュメント</h2>
      <ul>{docs.map((d) => <li><a href={`/docs/${d.id}`}>{d.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
