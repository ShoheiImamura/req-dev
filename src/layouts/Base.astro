---
import { getCollection } from 'astro:content';
import { STEPS } from '../lib/minimal-set';
import '../styles/global.css';

interface Props { title: string; currentId?: string }
const { title, currentId } = Astro.props;

const docs = await getCollection('docs');
const docsFor = (step: string) =>
  docs.filter((d) => d.data.step === step).sort((a, b) => a.id.length - b.id.length);
const openCount = docs.reduce((n, d) => n + d.data.questions.filter((q) => q.status === 'open').length, 0);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} | 要件定義</title>
  </head>
  <body>
    <div class="shell">
      <button class="side-toggle" type="button" aria-expanded="false" aria-controls="side-nav">メニュー</button>
      <nav class="side" id="side-nav">
        <h1><a href="/">要件定義</a></h1>
        <p class="side-section">価値から処理まで</p>
        <ol class="side-spine">
          {STEPS.map((step, i) => {
            const ds = docsFor(step.key);
            const num = <span class="num">{i + 1}</span>;
            if (ds.length === 0) {
              return (
                <li>
                  <span class="side-link is-todo">{num}<span class="dot todo"></span><span class="label">{step.name}</span></span>
                </li>
              );
            }
            if (ds.length === 1) {
              const d = ds[0];
              return (
                <li>
                  <a class="side-link" href={`/docs/${d.id}`} aria-current={d.id === currentId ? 'page' : undefined}>
                    {num}<span class={`dot ${d.data.status}`}></span><span class="label">{step.name}</span>
                  </a>
                </li>
              );
            }
            return (
              <li class="group">
                <span class="side-link is-group">{num}<span class="label">{step.name}</span></span>
                <ul>
                  {ds.map((d) => (
                    <li>
                      <a class="side-link is-sub" href={`/docs/${d.id}`} aria-current={d.id === currentId ? 'page' : undefined}>
                        <span class={`dot ${d.data.status}`}></span><span class="label">{d.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ol>
        <div class="side-top side-below">
          <a class="side-link" href="/questions" aria-current={Astro.url.pathname.startsWith('/questions') ? 'page' : undefined}>
            <span class="label">確認事項一覧</span><span class="count">未解決 {openCount}</span>
          </a>
          <a class="side-link" href="/notes" aria-current={Astro.url.pathname.startsWith('/notes') ? 'page' : undefined}>
            <span class="label">受領情報・調査メモ</span>
          </a>
        </div>
        <p class="side-legend">
          <span><span class="dot agreed"></span>合意済み</span>
          <span><span class="dot review"></span>お客様確認中</span>
          <span><span class="dot draft"></span>下書き</span>
          <span><span class="dot todo"></span>未作成</span>
        </p>
      </nav>
      <main class="main">
        <slot />
      </main>
    </div>
    <script is:inline>
      // スマホ幅でのメニュー開閉
      const toggle = document.querySelector('.side-toggle');
      const side = document.getElementById('side-nav');
      toggle?.addEventListener('click', () => {
        const open = side.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
    <script type="module" is:inline>
      if (document.querySelector('pre.mermaid')) {
        import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false });
          mermaid.run({ querySelector: 'pre.mermaid' });
        });
      }
    </script>
  </body>
</html>
